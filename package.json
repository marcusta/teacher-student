{
    "name": "teacher-student",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "bunx vite",
        "dev:server": "PORT=4810 bun --watch server/main.ts",
        "dev:seed": "bun scripts/dev-seed.ts",
        "dev:session": "bun scripts/dev-session.ts",
        "db:migrate": "bun scripts/db-migrate.ts",
        "db:health": "bun scripts/db-health.ts",
        "build": "NODE_ENV=production vite build",
        "check:client": "tsgo --noEmit",
        "check:server": "tsgo -p tsconfig.server.json --noEmit",
        "check:test": "tsgo -p tsconfig.test.json --noEmit",
        "check:i18n": "bun scripts/check-i18n.ts",
        "generate": "BASICS_API_OUT_DIR=web/api bun node_modules/@basics/core/generate-api.ts",
        "test": "bun ../mackans-client-fw/tools/assert-not-linked.ts && bun test",
        "test:server": "bun test server/",
        "test:client": "bun test tests/ web/",
        "test:affected": "BASICS_SCAN_DIRS=web,server,tests bun node_modules/@basics/core/affected-tests.ts",
        "fw:update": "bun ../mackans-client-fw/tools/update.ts"
    },
    "dependencies": {
        "@basics/core": "file:./vendor/basics-core-1.1.0.tgz",
        "@sinclair/typebox": "0.34.48",
        "hono": "4.11.9",
        "kysely": "0.27.6",
        "kysely-bun-sqlite": "0.3.2"
    },
    "devDependencies": {
        "@types/bun": "^1",
        "@typescript/native-preview": "^7.0.0-dev.20260211.1",
        "typescript": "^5.9.3",
        "vite": "^7.3.1"
    }
}
