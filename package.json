{
    "name": "teacher-student",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "bunx vite",
        "dev:server": "PORT=4810 bun --watch server/main.ts",
        "dev:seed": "bun scripts/dev-seed.ts",
        "dev:session": "bun scripts/dev-session.ts",
        "build": "NODE_ENV=production vite build",
        "check:client": "tsgo --noEmit",
        "check:server": "tsgo -p tsconfig.server.json --noEmit",
        "check:test": "tsgo -p tsconfig.test.json --noEmit",
        "check:i18n": "bun scripts/check-i18n.ts",
        "generate": "BASICS_API_OUT_DIR=web/api bun vendor/basics-core/generate-api.ts",
        "test": "bun test --path-ignore-patterns='vendor/**'",
        "test:server": "bun test --path-ignore-patterns='vendor/**' server/",
        "test:client": "bun test tests/ web/",
        "test:framework": "bun test vendor/basics-core/client/",
        "test:affected": "BASICS_SCAN_DIRS=web,server,tests bun vendor/basics-core/affected-tests.ts",
        "vendor:basics": "bun ./scripts/vendor-basics.ts"
    },
    "dependencies": {
        "@basics/core": "file:./vendor/basics-core",
        "@sinclair/typebox": "0.34.48",
        "hono": "4.11.9",
        "kysely": "0.27.6",
        "kysely-bun-sqlite": "0.3.2"
    },
    "devDependencies": {
        "@types/bun": "^1",
        "@typescript/native-preview": "^7.0.0-dev.20260211.1",
        "typescript": "^5.9.3",
        "vite": "^7.3.1"
    }
}
